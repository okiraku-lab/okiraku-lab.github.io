	var sd: f32 = (d2 - PSConstants2D.sdfParam.y);
	var shadowAlpha: f32 = clamp(sd / fwidth(sd) + 0.5, 0.0, 1.0);
	var sBase: f32 = shadowAlpha * (1.0 - textColor.a);

