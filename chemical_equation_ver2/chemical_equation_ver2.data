	var td: f32 = (d - PSConstants2D.sdfParam.x);
	var textAlpha: f32 = clamp(td / fwidth(td) + 0.5, 0.0, 1.0);

	var baseAlpha: f32 = (outlineAlpha - textAlpha);

	var color: vec4<f32> = vec4<f32>
	(
